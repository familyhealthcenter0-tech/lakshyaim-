rules_version = '2';

// Lakshyaim — storage rules
// Product images public read, uploads auth-only (demo)
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
