rules_version = '2';

// Lakshyaim — Firestore rules
// Public read, authenticated write (production me tighten hona zaroori hai)
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
